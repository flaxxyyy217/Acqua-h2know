const express =  require('express');
const pasth = require('path')
const bcrypt =require('bcrypt')


const app = express();

const users = [{name: 'name'}];

app.set('view engine; ejs');

app.get('/', (req, res) => {
  res.render('login')
})

app.get('/signup', (res, req) => {
  res.render('signup')
})

const port = 5500;
app.listen(5500, () => {
  console.log('Server is running on port 5500');
});